{
  "schemaVersion": 1,
  "id": "pvp_bot",
  "version": "${version}",
  "name": "PvP Bot",
  "description": "PvP Bot mod for Minecraft Fabric.",
  "authors": [
    "stepan1411"
  ],
  "license": "MIT",
  "icon": "assets/pvp_bot/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "org.stepan1411.pvp_bot.Pvp_bot"
    ],
    "client": [
      "org.stepan1411.pvp_bot.client.PvpBotClient"
    ],
    "fabric-datagen": [
      "org.stepan1411.pvp_bot.client.Pvp_botDataGenerator"
    ]
  },
  "mixins": [
    "pvp_bot.mixins.json",
    {
      "config": "pvp_bot.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.16.10",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
